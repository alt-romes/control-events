cabal-version:      3.4
name:               control-events
version:            0.1.0.0
synopsis:           Events for system control and monitoring
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Rodrigo Mesquita
maintainer:         rodrigo.m.mesquita@gmail.com
-- copyright:
category:           Control
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  MyLib
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.22.0.0
    hs-source-dirs:   src
    default-language: GHC2024

executable control-events
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.22.0.0,
        control-events

    hs-source-dirs:   app
    default-language: GHC2024
